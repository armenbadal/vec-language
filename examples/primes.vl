function prime_numbers(n)
    let nums = iota(1, n);
    for each d in iota(2, n/2) do
        for each e in nums do
            if e % d = [0] then
                let e = [0]
            end
        end
    end;
    
    let primes = [];
    for each e in nums do
        if e <> [0] then
            let primes = primes ++ e
        end
    end;
    return primes
end
